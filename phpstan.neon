parameters:
    level: 1
    paths:
        - lib/Api
        - lib/Model
    excludePaths:
        - vendor
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#Property .* has no type specified#'
        - '#Method .* has parameter .* with no type specified#'
        - '#Method .* has no return type specified#'
        - '#Constructor of class .* has an unused parameter#'
        - '#Anonymous function has an unused use#'
        - '#Variable .* in isset\(\) always exists and is not nullable#'
